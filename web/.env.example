# Guardian web configuration
# API base (defaults to /api, proxied to the backend in dev)
VITE_API_URL=/api
# Raster map tiles drawn over Guardian's built-in vector basemap. Leave empty to use only the vector basemap.
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
